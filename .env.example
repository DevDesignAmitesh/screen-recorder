# --- apps/server ---
PORT=4000
JWT_SECRET=change-me

# --- packages/db ---
DATABASE_URL=postgresql://user:password@localhost:5432/screen_recorder

# --- packages/notifications (email channel / Resend) ---
RESEND_API_KEY=

# --- packages/video-storage (S3-compatible bucket, e.g. Cloudflare R2) ---
STORAGE_REGION=auto
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_BUCKET_NAME=

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
