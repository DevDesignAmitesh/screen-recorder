# --- apps/server ---
PORT=4000
JWT_SECRET=change-me
# Shared secret for GET /api/v1/try/stats — paste it as ?key=... to check
# /try page usage numbers. There's no admin/role system in this app, so
# this is the whole access control for that endpoint.
TRY_STATS_KEY=change-me-too

# --- packages/db ---
DATABASE_URL=postgresql://user:password@localhost:5432/screen_recorder

# --- packages/notifications (email channel / Resend) ---
# Currently unused (v1 auth has no email step) — reserved for a future
# forgot-password flow.
RESEND_API_KEY=

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:4000
