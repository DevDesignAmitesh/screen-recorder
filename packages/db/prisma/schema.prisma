// Prisma schema for the screen-recorder app.
// Generated client is consumed by apps/server via @screen-recorder/db.

generator client {
  provider     = "prisma-client"
  output       = "../generated/client"
  runtime      = "bun"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

/// A registered user of the app.
model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  emailVerified Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  otpCodes   OtpCode[]
  wallpapers Wallpaper[]
  templates  Template[]
  recordings Recording[]
}

/// One-time codes used for email (and later SMS) verification/login.
/// A row is created on signup, checked + invalidated in /auth/verify-otp.
model OtpCode {
  id        String   @id @default(cuid())
  code      String
  purpose   OtpPurpose @default(SIGNUP_VERIFICATION)
  expiresAt DateTime
  consumedAt DateTime?
  createdAt DateTime @default(now())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum OtpPurpose {
  SIGNUP_VERIFICATION
  LOGIN
  PASSWORD_RESET
}

/// A background image shown behind the screen-share frame while recording.
/// Either a curated default (isDefault: true, ownerId null) or a
/// user-uploaded custom wallpaper.
model Wallpaper {
  id        String   @id @default(cuid())
  name      String
  url       String
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  recordings Recording[]

  @@index([ownerId])
}

/// A face-cam layout preset: where/how the webcam feed is overlaid on
/// the composited recording. Either a built-in default or user-saved.
model Template {
  id        String            @id @default(cuid())
  name      String
  position  TemplatePosition
  shape     TemplateShape
  size      Int               @default(220) // webcam diameter/side length in px, at a reference resolution
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())

  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  recordings Recording[]

  @@index([ownerId])
}

enum TemplatePosition {
  TOP_LEFT
  TOP_RIGHT
  BOTTOM_LEFT
  BOTTOM_RIGHT
  CENTER
}

enum TemplateShape {
  CIRCLE
  ROUNDED_SQUARE
  FULL_HEIGHT_STRIP
}

/// A finished, exported recording saved to a user's library.
model Recording {
  id       String  @id @default(cuid())
  title    String
  url      String
  duration Int // seconds
  createdAt DateTime @default(now())

  ownerId String
  owner   User   @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  wallpaperId String?
  wallpaper   Wallpaper? @relation(fields: [wallpaperId], references: [id], onDelete: SetNull)

  templateId String?
  template   Template? @relation(fields: [templateId], references: [id], onDelete: SetNull)

  @@index([ownerId])
}
